<UserControl x:Class="tenLabPractice.Items.useItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:tenLabPractice.Items"
             mc:Ignorable="d" 
             Margin="0,0,0,0">
    <StackPanel>
        <Grid Margin="0,12,0,12" x:Name="grid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="devName" Text="VR-шлем Meta Quest 3" Style="{StaticResource MainText}" FontSize="14" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="employee" Text="Иванов И. И." Style="{StaticResource MainText}" FontSize="14" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock x:Name="status" HorizontalAlignment="Center" Text="Ожидает выдачи" Style="{StaticResource MainText}" FontSize="14" Grid.Column="2" VerticalAlignment="Center"/>
            <TextBlock x:Name="dateTo" HorizontalAlignment="Right" Text="06.09.26" Style="{StaticResource MainText}" FontSize="14" Grid.Column="3" VerticalAlignment="Center"/>
            <TextBlock x:Name="dateFrom" HorizontalAlignment="Right" Text="11.09.26" Style="{StaticResource MainText}" FontSize="14" Grid.Column="4" VerticalAlignment="Center"/>
        </Grid>

        <Border Background="#515151" Height="1.5" Opacity="0.7"/>
    </StackPanel>
</UserControl>

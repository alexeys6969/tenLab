<UserControl x:Class="tenLabPractice.Items.serviceItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:tenLabPractice.Items"
             mc:Ignorable="d"
             Margin="0,15,0,0">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="devName" Text="VR-шлем Meta Quest 3" Style="{StaticResource MainText}" Grid.Column="0"/>
            <TextBlock x:Name="reason" HorizontalAlignment="Center" Text="Не работает контроллер" Style="{StaticResource MainText}" Grid.Column="1"/>
            <TextBlock x:Name="status" HorizontalAlignment="Right" Text="Не работает" Style="{StaticResource MainText}" Grid.Column="2"/>
        </Grid>
        <Grid Grid.ColumnSpan="3" Margin="0,10,0,0" Background="#515151" Height="1"/>
    </StackPanel>
</UserControl>

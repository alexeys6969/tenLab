<UserControl x:Class="tenLabPractice.Items.serviceItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:tenLabPractice.Items"
             mc:Ignorable="d"
             Margin="0,0,0,0">
    <StackPanel>
        <Grid Margin="0,12,0,12" x:Name="grid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="devName" Text="VR-шлем Meta Quest 3" Style="{StaticResource MainText}" FontSize="14" Grid.Column="0" VerticalAlignment="Center"/>

            <TextBlock x:Name="reason" HorizontalAlignment="Center" Text="Не работает контроллер" Style="{StaticResource MainText}" FontSize="14" Grid.Column="1" VerticalAlignment="Center"/>
            
            <TextBlock x:Name="status" HorizontalAlignment="Center" Text="В работе" Style="{StaticResource MainText}" FontSize="14" Grid.Column="2" VerticalAlignment="Center"/>

            <TextBlock x:Name="date" HorizontalAlignment="Right" Text="10.09.26" Style="{StaticResource MainText}" FontSize="14" Grid.Column="3" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.ColumnSpan="3" Background="#515151" Height="1.5" Opacity="0.7"/>
    </StackPanel>
</UserControl>

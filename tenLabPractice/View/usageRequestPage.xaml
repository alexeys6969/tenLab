<Page x:Class="tenLabPractice.View.usageRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:tenLabPractice.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#202020"
      Title="usageRequestPage">

    <Grid>
        <!-- Общий ScrollViewer на случай маленьких экранов -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="50,0,50,40">

                <!-- Контейнер для нашего переделанного адаптивного хедера -->
                <StackPanel x:Name="headerParent" Margin="0,15,0,0" HorizontalAlignment="Stretch"/>

                <!-- Блок с карточками устройств -->
                <Grid Margin="0,45,0,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая карточка (Увеличили шрифты и высоту кнопки) -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,40,0">
                        <TextBlock Text="Всего устройств свободно: " x:Name="devFreeCount" Style="{StaticResource MainText}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Из них: " x:Name="devFreeList" Style="{StaticResource MainText}" FontSize="14" Foreground="#FFFFFF" Margin="0,6,0,0"/>
                        <Button Content="Создать заявку на использование" Click="createRequest" Style="{StaticResource ButtonStyle}" Background="#333333" BorderThickness="0" Height="38" FontSize="13" Margin="0,15,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Правая карточка (Для симметрии, если появится контент) -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Margin="40,0,0,0">
                        <!-- Сюда встанет блок 'Устройств в обслуживании', как на макете -->
                    </StackPanel>
                </Grid>

                <!-- Блок нижних заявок -->
                <StackPanel Margin="0,40,0,0">
                    <TextBlock Text="Последние заявки:" Style="{StaticResource MainText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <StackPanel x:Name="useParent" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Все заявки" Click="toUsable" Margin="0,0,40,0" Style="{StaticResource ButtonStyle}" Background="#333333" BorderThickness="0" Height="38" FontSize="13" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

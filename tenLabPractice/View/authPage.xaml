<Page x:Class="tenLabPractice.Pages.authPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:tenLabPractice.Pages"
      mc:Ignorable="d"
      Title="authPage"
      d:Width="800"
      d:Height="450"
      Background="#202020"
      FontFamily="Fonts\Inter_28pt-Medium.ttf">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">

        <Grid Background="#1E1E1E" MinHeight="550">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Margin="50,0,50,0">
                <Image Source="/Images/tenLabLogo.png" Width="150" Height="43" HorizontalAlignment="Center"/>
                <TextBlock Text="Добро пожаловать" Style="{StaticResource MainTB}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                <TextBlock Text="Войдите в свой аккаунт Тенлаб" Style="{StaticResource MainText}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="3" Background="#FFF" CornerRadius="20" Margin="50,0,50,0" Padding="0,10,0,15">
                <StackPanel>
                    <TextBlock Text="Email:" Style="{StaticResource MainText}" HorizontalAlignment="Left" Foreground="#666666" Margin="25,15,0,0"/>
                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="25,6,25,0" Height="30" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Пароль:" Style="{StaticResource MainText}" Foreground="#666666" Margin="25,12,0,0"/>
                    <PasswordBox Style="{StaticResource PasswordBoxStyle}" Margin="25,6,25,0" Height="30" VerticalContentAlignment="Center"/>

                    <CheckBox Content="Запомнить меня" Style="{StaticResource CheckBoxStyle}" Margin="25,12,0,0"/>

                    <Button Click="Authorization" Content="Войти" Style="{StaticResource ButtonStyle}" BorderThickness="0" Height="35" Margin="25,20,25,5"/>

                    <Button BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" Margin="25,5,0,10">
                        <TextBlock Text="Забыли пароль?" Style="{StaticResource MainText}" Foreground="#2867F2" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Блок 3: Футер -->
            <StackPanel Grid.Row="5" Margin="50,0,50,0">
                <TextBlock Text="Корпоративная система Тенлаб" Style="{StaticResource MainText}" HorizontalAlignment="Center"/>
                <TextBlock Text="© 2026 Тенлаб" Style="{StaticResource MainText}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
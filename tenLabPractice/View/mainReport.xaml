<Page x:Class="tenLabPractice.Pages.mainReport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:Width="800"
      d:Height="450"
      Background="#202020"
      Title="mainReport">

    <Grid>
        <!-- ScrollViewer защитит интерфейс, если окно вертикально сожмут -->
        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="50,0,50,40">

                <!-- Контейнер для нашего обновленного адаптивного хедера -->
                <StackPanel x:Name="headerParent" Margin="0,15,0,0" HorizontalAlignment="Stretch"/>

                <!-- Две колонки с основной статистикой -->
                <Grid Margin="0,45,0,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: Всего устройств используется -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,40,0">
                        <TextBlock Text="Всего устройств используется: " x:Name="devUseCount" Style="{StaticResource MainText}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Из них: " x:Name="devUseList" Style="{StaticResource MainText}" FontSize="14" Foreground="#FFFFFF" Margin="0,6,0,0"/>
                        <!-- Кнопка увеличена до 38px, шрифт до 13 -->
                        <Button Content="Подробнее" Click="toUsableDevice" Style="{StaticResource ButtonStyle}" Background="#333333" BorderThickness="0" Height="38" FontSize="13" Margin="0,15,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Правая колонка: Устройств в обслуживании -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Margin="40,0,0,0">
                        <TextBlock Text="Устройств в обслуживании: " x:Name="devServiceCount" Style="{StaticResource MainText}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Из них: " x:Name="devServiceList" Style="{StaticResource MainText}" FontSize="14" Foreground="#FFFFFF" Margin="0,6,0,0"/>
                        <!-- Кнопка увеличена до 38px, шрифт до 13 -->
                        <Button Content="Подробнее" Click="toServicableDevice" Style="{StaticResource ButtonStyle}" Background="#333333" BorderThickness="0" Height="38" FontSize="13" Margin="0,15,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <!-- Блок нижних заявок на обслуживание -->
                <StackPanel Margin="0,40,0,0">
                    <TextBlock Text="Последние заявки на обслуживание:" Style="{StaticResource MainText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="serviceParent" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

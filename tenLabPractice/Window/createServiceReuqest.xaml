<Window x:Class="tenLabPractice.Window.createServiceReuqest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tenLabPractice.Window"
        mc:Ignorable="d"
        Title="createServiceReuqest"
        Width="350"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="#333333">
        <!-- Ограничиваем размеры карточки по центру экрана -->
        <Border Background="#333333"  
        CornerRadius="12" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center"
        Padding="30,25,30,25">

            <StackPanel>
                <!-- Заголовок окна -->
                <TextBlock Text="Создание заявки на обслуживание" Style="{StaticResource MainText}" FontSize="16"/>

                <!-- Блок выбора устройства -->
                <TextBlock Text="Выберите устройство:" Style="{StaticResource MainText}" Margin="0,5,0,0"/>
                <ComboBox Style="{StaticResource CustomComboBox}" Text="Выберите..." Margin="0,5,0,0">
                    <!-- Ниже примеры элементов, которые будут внутри -->
                    <ComboBoxItem Content="VR-шлем Meta Quest 3"/>
                    <ComboBoxItem Content="Ноутбук ASUS ROG"/>
                    <ComboBoxItem Content="Графический планшет Wacom"/>
                </ComboBox>

                <!-- Блок указания дат -->
                <TextBlock Text="Укажите причину" Style="{StaticResource MainText}" Margin="0,15,0,0"/>

                <!-- Поле: Беру -->
                <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,0,0,8" Background="#333333" BorderBrush="#515151" MinHeight="36" TextWrapping="Wrap"/>

                <!-- Финальная кнопка отправки -->
                <Button Content="Отправить заявку" Style="{StaticResource ButtonStyle}" Background="#4A7BBA" Height="25" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
